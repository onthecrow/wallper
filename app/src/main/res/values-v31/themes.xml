<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The system splash screen (API 31+) reads the activity theme. -->
    <style name="Theme.Wallper" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <!-- Its brush hides the W in the background colour: an icon background needs the brush in its colour. -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/avd_splash_logo</item>
        <!-- The drawable's duration. Read up to API 32; later the system takes it from the drawable. -->
        <item name="android:windowSplashScreenAnimationDuration">900</item>
<!--        <item name="android:windowSplashScreenIconBackgroundColor">@color/...</item>-->
    </style>
</resources>
