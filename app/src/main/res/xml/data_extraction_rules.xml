<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+. No cloud backup, like allowBackup="false" before 12: the videos don't fit its 25 MB quota,
    and a database restored without them only shows placeholders. A device-to-device transfer has no
    quota and moves the files with the database, so it stays on.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
</data-extraction-rules>
